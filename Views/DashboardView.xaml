                                <TextBlock Text="OPEN" Style="{StaticResource SectionLbl}"/>
                                <TextBlock Text="5" Foreground="{DynamicResource Color.Warning}" FontFamily="Consolas" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                                <TextBlock Text="ports" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="FILTERED" Style="{StaticResource SectionLbl}"/>
                                <TextBlock Text="12" Foreground="{DynamicResource Color.Accent}" FontFamily="Consolas" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                                <TextBlock Text="ports" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="RISK LEVEL" Style="{StaticResource SectionLbl}"/>
                                <TextBlock Text="MED" Foreground="{DynamicResource Color.Warning}" FontFamily="Consolas" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                                <TextBlock Text="review needed" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Port risk meter -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="RISK ASSESSMENT" Style="{StaticResource SectionLbl}" Margin="0,0,0,14"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Exposure Score" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11"/>
                                <ProgressBar Grid.Column="1" Value="45" Maximum="100" Style="{StaticResource MeterBarOrange}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="45/100" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Critical Ports" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11"/>
                                <ProgressBar Grid.Column="1" Value="20" Maximum="100" Style="{StaticResource MeterBarRed}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="1 found" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Firewall Coverage" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11"/>
                                <ProgressBar Grid.Column="1" Value="80" Maximum="100" Style="{StaticResource MeterBarGreen}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="80%" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Port results table -->
                    <Border Background="{DynamicResource Bg.Surface}" CornerRadius="10"
                            BorderBrush="{DynamicResource Border.Primary}" BorderThickness="1">
                        <StackPanel>
                            <Border Padding="16,12" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                                <TextBlock Text="OPEN PORT RESULTS" Style="{StaticResource SectionLbl}"/>
                            </Border>
                            <!-- Column headers -->
                            <Grid Margin="16,10,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PORT"     Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="PROTOCOL"  Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="SERVICE"   Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Grid.Column="3" Text="STATE"     Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Grid.Column="4" Text="RISK"      Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                            </Grid>
                            <!-- Sample port rows -->
                            <Border Background="{DynamicResource Bg.RowEven}" Padding="16,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="22" Foreground="{DynamicResource Text.TableIp}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="TCP" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="SSH (Secure Shell)" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Grid.Column="3" Background="{DynamicResource Bg.TagNew}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="OPEN" Foreground="{DynamicResource Color.Success}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                    <Border Grid.Column="4" Background="{DynamicResource Bg.TagError}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="HIGH" Foreground="{DynamicResource Color.Danger}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource Bg.RowOdd}" Padding="16,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="80" Foreground="{DynamicResource Text.TableIp}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="TCP" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="HTTP (Web server)" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Grid.Column="3" Background="{DynamicResource Bg.TagNew}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="OPEN" Foreground="{DynamicResource Color.Success}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                    <Border Grid.Column="4" Background="{DynamicResource Bg.Input}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="MED" Foreground="{DynamicResource Color.Warning}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource Bg.RowEven}" Padding="16,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="443" Foreground="{DynamicResource Text.TableIp}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="TCP" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="HTTPS (Secure web)" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Grid.Column="3" Background="{DynamicResource Bg.TagNew}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="OPEN" Foreground="{DynamicResource Color.Success}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                    <Border Grid.Column="4" Background="{DynamicResource Bg.TagNew}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="LOW" Foreground="{DynamicResource Color.Success}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ════════════════════════════════════════════════
                 PAGE 8 — WAKE-ON-LAN
                 ════════════════════════════════════════════════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NavWake}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="24,20,24,24">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="WAKE-ON-LAN" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Send a magic packet to wake up sleeping devices remotely" Style="{StaticResource PageSub}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Input card -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="SEND MAGIC PACKET" Style="{StaticResource SectionLbl}" Margin="0,0,0,14"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="MAC Address" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="AA:BB:CC:DD:EE:FF"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Broadcast IP" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="255.255.255.255"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Port" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="9" Width="100" HorizontalAlignment="Left"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="SEND MAGIC PACKET" Style="{StaticResource PrimaryBtn}" Margin="0,0,12,0"/>
                                <Button Content="TEST REACHABILITY"  Style="{StaticResource GhostBtn}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- How it works -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="HOW WAKE-ON-LAN WORKS" Style="{StaticResource SectionLbl}" Margin="0,0,0,14"/>
                            <!-- Step flow -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Step 1 -->
                                <Border Grid.Column="0" Background="{DynamicResource Bg.Input}" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="01" Foreground="{DynamicResource Color.Accent}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="Enter MAC" Foreground="{DynamicResource Text.Primary}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="Target device's hardware address" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="1" Text="→" Foreground="{DynamicResource Text.Muted}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- Step 2 -->
                                <Border Grid.Column="2" Background="{DynamicResource Bg.Input}" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="02" Foreground="{DynamicResource Color.Success}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="Magic Packet" Foreground="{DynamicResource Text.Primary}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="UDP broadcast with 6×FF then MAC×16" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="3" Text="→" Foreground="{DynamicResource Text.Muted}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- Step 3 -->
                                <Border Grid.Column="4" Background="{DynamicResource Bg.Input}" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="03" Foreground="{DynamicResource Color.Warning}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="NIC Wakes" Foreground="{DynamicResource Text.Primary}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="Device network card receives and triggers boot" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="5" Text="→" Foreground="{DynamicResource Text.Muted}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- Step 4 -->
                                <Border Grid.Column="6" Background="{DynamicResource Bg.Input}" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="04" Foreground="{DynamicResource Color.Purple}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="Device Online" Foreground="{DynamicResource Text.Primary}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="Ping to confirm device is now reachable" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Saved WoL targets -->
                    <TextBlock Text="SAVED TARGETS" Style="{StaticResource SectionLbl}" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource Bg.Surface}" CornerRadius="10"
                            BorderBrush="{DynamicResource Border.Primary}" BorderThickness="1">
                        <!-- Column headers -->
                        <StackPanel>
                            <Border Padding="16,10" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DEVICE NAME"  Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="MAC ADDRESS"   Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="2" Text="LAST WOKE"     Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="3" Text="STATUS"        Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="4" Text="ACTION"        Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                            <Border Padding="16,10" Background="{DynamicResource Bg.RowEven}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="My Desktop PC" Foreground="{DynamicResource Text.Primary}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="AA:BB:CC:11:22:33" Foreground="{DynamicResource Text.TableMac}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="2 hours ago" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Grid.Column="3" Background="{DynamicResource Bg.TagNew}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="ONLINE" Foreground="{DynamicResource Color.Success}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                    <Button Grid.Column="4" Content="WAKE" Style="{StaticResource GhostBtn}" Padding="10,6" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Padding="16,10" Background="{DynamicResource Bg.RowOdd}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Media Server" Foreground="{DynamicResource Text.Primary}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="DD:EE:FF:44:55:66" Foreground="{DynamicResource Text.TableMac}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Yesterday" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Grid.Column="3" Background="{DynamicResource Bg.Input}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="OFFLINE" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                    <Button Grid.Column="4" Content="WAKE" Style="{StaticResource PrimaryBtn}" Padding="10,6" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
        <!-- end Page Area -->
    </Grid>
    <!-- end Root -->
</UserControl>