<UserControl x:Class="UyKonek.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:UyKonek.Converters"
             Background="{DynamicResource Bg.Window}">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource Bg.Card}"
                BorderBrush="{DynamicResource Border.Card}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="NAVIGATION" Foreground="{DynamicResource Text.Muted}" FontWeight="Bold"/>
                    <Button Margin="0,10,0,0" Content="Network Scan" Command="{Binding ShowNetworkScanCommand}"/>
                    <Button Margin="0,6,0,0" Content="Device Inventory" Command="{Binding ShowDeviceInventoryCommand}"/>
                    <Button Margin="0,6,0,0" Content="Device Details" Command="{Binding ShowDeviceDetailsCommand}"/>
                    <Button Margin="0,6,0,0" Content="Alerts" Command="{Binding ShowAlertsCommand}"/>

                    <Separator Margin="0,12,0,12"/>
                    <TextBlock Text="DIAGNOSTICS" Foreground="{DynamicResource Text.Muted}" FontWeight="Bold"/>
                    <Button Margin="0,10,0,0" Content="Ping" Command="{Binding ShowPingCommand}"/>
                    <Button Margin="0,6,0,0" Content="Traceroute" Command="{Binding ShowTracerouteCommand}"/>
                    <Button Margin="0,6,0,0" Content="Open Ports" Command="{Binding ShowOpenPortsCommand}"/>
                    <Button Margin="0,6,0,0" Content="Wake-on-LAN" Command="{Binding ShowWakeOnLanCommand}"/>

                    <Separator Margin="0,12,0,12"/>
                    <Button Content="Toggle Theme" Command="{Binding ToggleThemeCommand}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource Bg.Card}"
                    BorderBrush="{DynamicResource Border.Card}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding ActiveSection}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock Text="Backend: " Foreground="{DynamicResource Text.Muted}"/>
                        <TextBlock Text="{Binding BackendStatusLabel}" Foreground="{DynamicResource Color.Accent}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Scan Network" Command="{Binding ScanCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Command="{Binding CancelCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Background="{DynamicResource Bg.Card}"
                    BorderBrush="{DynamicResource Border.Card}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Color.Danger}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource Bg.Surface}"
                        BorderBrush="{DynamicResource Border.Primary}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8">
                    <DataGrid ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="*"/>
                            <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="*"/>
                            <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*"/>
                            <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="*"/>
                            <DataGridCheckBoxColumn Header="New" Binding="{Binding IsNew}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="1" Margin="0,10,0,10" Padding="12"
                        Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Card}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Diagnostic Target" FontWeight="Bold"/>
                            <TextBox Margin="0,6,0,0" MinWidth="220"
                                     Text="{Binding DiagnosticTargetIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Use Selected Device" Command="{Binding UseSelectedDeviceCommand}" Margin="0,0,8,0"/>
                            <Button Content="Run" Command="{Binding RunDiagnosticCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Primary}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Output: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding DiagnosticOutput}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,8,0,8" Orientation="Horizontal"
                                    Visibility="{Binding IsPingSection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Alive: " FontWeight="Bold"/>
                            <TextBlock Text="{Binding PingAlive}" Margin="0,0,12,0"/>
                            <TextBlock Text="Latency(ms): " FontWeight="Bold"/>
                            <TextBlock Text="{Binding PingLatencyMs}" Margin="0,0,12,0"/>
                            <TextBlock Text="Meter: " FontWeight="Bold"/>
                            <ProgressBar Width="140" Height="14" Value="{Binding PingMeterValue}" Maximum="100"/>
                        </StackPanel>

                        <ListBox Grid.Row="2" ItemsSource="{Binding DiagnosticLines}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
