<UserControl x:Class="UyKonek.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:UyKonek.Converters"
             Background="{DynamicResource Bg.Window}">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>

        <!-- ═══ NAV BUTTON ══════════════════════════════════════ -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource Text.Nav}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="GroupName"       Value="NavGroup"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Margin="8,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Ind" Grid.Column="0" Background="{DynamicResource Color.Accent}"
                                        CornerRadius="2" Opacity="0" Margin="0,8"/>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Tag}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Lbl" Grid.Column="2" Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,12"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource Bg.NavHover}"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource Text.NavHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource Bg.NavActive}"/>
                                <Setter TargetName="Ind" Property="Opacity"    Value="1"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource Color.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ NAV SECTION LABEL ════════════════════════════════ -->
        <Style x:Key="NavSection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="16,14,0,4"/>
        </Style>

        <!-- ═══ PRIMARY BUTTON ══════════════════════════════════ -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00C4DF" Offset="0"/>
                                    <GradientStop Color="#006E8A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#00E5FF" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ GHOST BUTTON ════════════════════════════════════ -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource Text.GhostBtn}"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Border.GhostBtn}"/>
            <Setter Property="Padding"         Value="14,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Bg.NavHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Color.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Color.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ DANGER BUTTON ═══════════════════════════════════ -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource Text.DangerBtn}"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Border.DangerBtn}"/>
            <Setter Property="Padding"         Value="14,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Bg.TagError}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Color.Danger}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Color.Danger}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ THEME TOGGLE BUTTON ════════════════════════════ -->
        <Style x:Key="ThemeBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource Bg.ThemeToggle}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Text.ThemeIcon}"/>
            <Setter Property="FontFamily"      Value="Segoe UI Symbol"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Border.GhostBtn}"/>
            <Setter Property="Width"           Value="36"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Bg.NavHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Color.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Color.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ COLUMN HEADER ════════════════════════════════════ -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{DynamicResource Bg.ColHeader}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Text.ColHeader}"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="9"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ DATAGRID ROW ════════════════════════════════════ -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background"      Value="{DynamicResource Bg.RowEven}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource Bg.RowOdd}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Bg.RowHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Bg.RowSelected}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ DATAGRID CELL ════════════════════════════════════ -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" BorderThickness="0" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Color.Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ PROGRESS BAR ════════════════════════════════════ -->
        <Style x:Key="ScanProgress" TargetType="ProgressBar">
            <Setter Property="Height"          Value="2"/>
            <Setter Property="Background"      Value="{DynamicResource Bg.ProgressTrack}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Color.Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="1">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                        CornerRadius="1" HorizontalAlignment="Left">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="6" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ SCROLLBAR ════════════════════════════════════════ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width"      Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" CornerRadius="2" Width="4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Color.ScrollThumb}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ CARD BORDER ══════════════════════════════════════ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource Bg.Card}"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Border.Card}"/>
            <Setter Property="Padding"         Value="16,14"/>
        </Style>

        <!-- ═══ SECTION LABEL ════════════════════════════════════ -->
        <Style x:Key="SectionLbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ═══ PAGE TITLE ═══════════════════════════════════════ -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ═══ PAGE SUBTITLE ════════════════════════════════════ -->
        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,2,0,0"/>
        </Style>

        <!-- ═══ INPUT BOX ════════════════════════════════════════ -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource Bg.Input}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Text.Primary}"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource Color.Accent}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Border.GhostBtn}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Color.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ COMBOBOX ════════════════════════════════════════ -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Background"      Value="{DynamicResource Bg.Input}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Border.GhostBtn}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="10,7"/>
        </Style>

        <!-- ═══ ACCENT METER BAR (horizontal progress fill) ══════ -->
        <Style x:Key="MeterBar" TargetType="ProgressBar">
            <Setter Property="Height"          Value="6"/>
            <Setter Property="Background"      Value="{DynamicResource Bg.ProgressTrack}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Color.Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3" HorizontalAlignment="Left"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ SUCCESS METER BAR ════════════════════════════════ -->
        <Style x:Key="MeterBarGreen" TargetType="ProgressBar" BasedOn="{StaticResource MeterBar}">
            <Setter Property="Foreground" Value="{DynamicResource Color.Success}"/>
        </Style>

        <!-- ═══ WARNING METER BAR ════════════════════════════════ -->
        <Style x:Key="MeterBarOrange" TargetType="ProgressBar" BasedOn="{StaticResource MeterBar}">
            <Setter Property="Foreground" Value="{DynamicResource Color.Warning}"/>
        </Style>

        <!-- ═══ DANGER METER BAR ═════════════════════════════════ -->
        <Style x:Key="MeterBarRed" TargetType="ProgressBar" BasedOn="{StaticResource MeterBar}">
            <Setter Property="Foreground" Value="{DynamicResource Color.Danger}"/>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════
         ROOT: SIDEBAR  +  PAGE AREA
         ═══════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════
             SIDEBAR
             ══════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource Bg.Sidebar}"
                BorderBrush="{DynamicResource Border.Primary}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Identity card -->
                <Border DockPanel.Dock="Top" Margin="12,16,12,8"
                        Background="{DynamicResource Bg.Card}"
                        CornerRadius="10" BorderBrush="{DynamicResource Border.Card}"
                        BorderThickness="1" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Color.Success}"
                                     Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#00D68F" BlurRadius="6" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="CONNECTED" Foreground="{DynamicResource Color.Success}"
                                       FontFamily="Consolas" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="BACKEND ENDPOINT" Foreground="{DynamicResource Text.Muted}"
                                   FontFamily="Consolas" FontSize="9" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding BackendUrl}" Foreground="{DynamicResource Text.Secondary}"
                                   FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Error banner -->
                <Border DockPanel.Dock="Top" Margin="12,0,12,4"
                        Background="{DynamicResource Bg.TagError}" CornerRadius="8"
                        BorderBrush="{DynamicResource Border.Error}" BorderThickness="1"
                        Padding="12,10"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="ERROR" Foreground="{DynamicResource Color.Danger}"
                                   FontFamily="Consolas" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Text.Error}"
                                   FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Navigation links -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,0">

                        <TextBlock Text="MAIN" Style="{StaticResource NavSection}"/>
                        <RadioButton x:Name="NavScan" Style="{StaticResource NavBtn}" Content="NETWORK SCAN" IsChecked="True">
                            <RadioButton.Tag>
                                <TextBlock Text="⬡" Foreground="{DynamicResource Color.Accent}" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="NavInventory" Style="{StaticResource NavBtn}" Content="DEVICE INVENTORY">
                            <RadioButton.Tag>
                                <TextBlock Text="▤" Foreground="{DynamicResource Text.Nav}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="NavDetails" Style="{StaticResource NavBtn}" Content="DEVICE DETAILS">
                            <RadioButton.Tag>
                                <TextBlock Text="◧" Foreground="{DynamicResource Text.Nav}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="NavAlerts" Style="{StaticResource NavBtn}" Content="ALERTS">
                            <RadioButton.Tag>
                                <TextBlock Text="◈" Foreground="{DynamicResource Text.Nav}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton.Tag>
                        </RadioButton>

                        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource NavSection}"/>
                        <RadioButton x:Name="NavPing" Style="{StaticResource NavBtn}" Content="PING">
                            <RadioButton.Tag>
                                <TextBlock Text="◎" Foreground="{DynamicResource Text.Nav}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="NavTrace" Style="{StaticResource NavBtn}" Content="TRACEROUTE">
                            <RadioButton.Tag>
                                <TextBlock Text="⤳" Foreground="{DynamicResource Text.Nav}" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="NavPorts" Style="{StaticResource NavBtn}" Content="OPEN PORTS">
                            <RadioButton.Tag>
                                <TextBlock Text="⬡" Foreground="{DynamicResource Text.Nav}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="NavWake" Style="{StaticResource NavBtn}" Content="WAKE-ON-LAN">
                            <RadioButton.Tag>
                                <TextBlock Text="⏻" Foreground="{DynamicResource Text.Nav}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton.Tag>
                        </RadioButton>

                        <TextBlock Text="PERFORMANCE" Style="{StaticResource NavSection}"/>
                        <RadioButton x:Name="NavSpeed" Style="{StaticResource NavBtn}" Content="SPEED TEST">
                            <RadioButton.Tag>
                                <TextBlock Text="▶" Foreground="{DynamicResource Text.Nav}" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="NavIsp" Style="{StaticResource NavBtn}" Content="ISP COMPARE">
                            <RadioButton.Tag>
                                <TextBlock Text="⟺" Foreground="{DynamicResource Text.Nav}" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton.Tag>
                        </RadioButton>

                        <TextBlock Text="SECURITY" Style="{StaticResource NavSection}"/>
                        <RadioButton x:Name="NavCam" Style="{StaticResource NavBtn}" Content="FIND CAMERAS">
                            <RadioButton.Tag>
                                <TextBlock Text="◉" Foreground="{DynamicResource Text.Nav}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="NavPresence" Style="{StaticResource NavBtn}" Content="PRESENCE">
                            <RadioButton.Tag>
                                <TextBlock Text="◐" Foreground="{DynamicResource Text.Nav}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </RadioButton.Tag>
                        </RadioButton>

                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom: count + theme toggle -->
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,16"
                        Background="{DynamicResource Bg.Card}" CornerRadius="8"
                        BorderBrush="{DynamicResource Border.Card}" BorderThickness="1"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DEVICES FOUND" Foreground="{DynamicResource Text.Muted}"
                                       FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Devices.Count}"
                                       Foreground="{DynamicResource Color.Accent}"
                                       FontFamily="Consolas" FontSize="22" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ThemeBtn}"
                                Content="{Binding ThemeIcon}" ToolTip="{Binding ThemeLabel}"
                                Command="{Binding ToggleThemeCommand}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════
             PAGE AREA  (radio-button driven tabs)
             ══════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{DynamicResource Bg.Window}">

            <!-- ════════════════════════════════════════════════
                 PAGE 1 — NETWORK SCAN
                 ════════════════════════════════════════════════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NavScan}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="24,20,24,24">

                    <!-- Header row -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="NETWORK SCAN" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageSub}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="COPY IP"   Style="{StaticResource GhostBtn}" Command="{Binding CopyIpCommand}"  Margin="0,0,8,0"/>
                            <Button Content="COPY MAC"  Style="{StaticResource GhostBtn}" Command="{Binding CopyMacCommand}" Margin="0,0,8,0"/>
                            <Button Content="CANCEL"    Style="{StaticResource DangerBtn}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="SCAN NETWORK" Style="{StaticResource PrimaryBtn}" Command="{Binding ScanCommand}"
                                    Visibility="{Binding IsScanning, Converter={StaticResource InvBoolToVis}}"/>
                            <Button Content="SCANNING..."  Style="{StaticResource PrimaryBtn}" IsEnabled="False"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Scan progress bar -->
                    <ProgressBar Style="{StaticResource ScanProgress}" IsIndeterminate="True"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                                 Margin="0,0,0,16"/>

                    <!-- KPI row -->
                    <UniformGrid Columns="4" Rows="1" Margin="0,0,0,16">
                        <!-- Total devices -->
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TOTAL DEVICES" Style="{StaticResource SectionLbl}"/>
                                    <TextBlock Text="{Binding Devices.Count}"
                                               Foreground="{DynamicResource Color.Accent}"
                                               FontFamily="Consolas" FontSize="32" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock Text="on network" Foreground="{DynamicResource Text.Muted}"
                                               FontFamily="Consolas" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Canvas Grid.Column="1" Width="40" Height="40" VerticalAlignment="Center">
                                    <Ellipse Width="40" Height="40" Stroke="{DynamicResource Border.Card}" StrokeThickness="1"/>
                                    <Ellipse Width="28" Height="28" Canvas.Left="6" Canvas.Top="6" Stroke="{DynamicResource Border.Card}" StrokeThickness="1"/>
                                    <Ellipse Width="6" Height="6" Canvas.Left="17" Canvas.Top="17" Fill="{DynamicResource Color.Accent}">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#00E5FF" BlurRadius="8" ShadowDepth="0"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Canvas>
                            </Grid>
                        </Border>
                        <!-- Online -->
                        <Border Style="{StaticResource Card}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="ONLINE" Style="{StaticResource SectionLbl}"/>
                                <TextBlock Text="{Binding Devices.Count}" Foreground="{DynamicResource Color.Success}"
                                           FontFamily="Consolas" FontSize="32" FontWeight="Bold" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Color.Success}" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#00D68F" BlurRadius="4" ShadowDepth="0"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="responding" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- New devices -->
                        <Border Style="{StaticResource Card}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="NEW DEVICES" Style="{StaticResource SectionLbl}"/>
                                <TextBlock Text="0" Foreground="{DynamicResource Color.Warning}"
                                           FontFamily="Consolas" FontSize="32" FontWeight="Bold" Margin="0,4,0,0"/>
                                <TextBlock Text="since last scan" Foreground="{DynamicResource Text.Muted}"
                                           FontFamily="Consolas" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Scan duration -->
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="LAST SCAN" Style="{StaticResource SectionLbl}"/>
                                <TextBlock Text="—" Foreground="{DynamicResource Text.Primary}"
                                           FontFamily="Consolas" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                                <TextBlock Text="duration / ms" Foreground="{DynamicResource Text.Muted}"
                                           FontFamily="Consolas" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Charts row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <!-- Vendor bar chart -->
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="DEVICE VENDORS" Style="{StaticResource SectionLbl}" Margin="0,0,0,14"/>
                                <!-- Bar chart rows — static demo data, wire to real data via ItemsControl -->
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Apple" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Value="72" Maximum="100" Style="{StaticResource MeterBar}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="72%" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Samsung" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Value="45" Maximum="100" Style="{StaticResource MeterBarGreen}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="45%" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="TP-Link" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Value="28" Maximum="100" Style="{StaticResource MeterBarOrange}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="28%" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Unknown" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Value="15" Maximum="100" Style="{StaticResource MeterBarRed}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="15%" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Cisco" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Value="10" Maximum="100" Style="{StaticResource MeterBar}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="10%" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Device type donut (Canvas-drawn) -->
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="DEVICE TYPES" Style="{StaticResource SectionLbl}" Margin="0,0,0,10"/>
                                <!-- Donut rings drawn with arcs -->
                                <Canvas Width="130" Height="130" HorizontalAlignment="Center">
                                    <!-- Outer ring background -->
                                    <Ellipse Width="130" Height="130" Stroke="{DynamicResource Border.Card}" StrokeThickness="18" Fill="Transparent"/>
                                    <!-- Mobile — 45% (162°) cyan arc approximated with a thick stroke Path -->
                                    <Path Stroke="{DynamicResource Color.Accent}" StrokeThickness="18" Fill="Transparent"
                                          Data="M 65,4 A 61,61 0 0 1 118,95"/>
                                    <!-- Router — 25% (90°) green -->
                                    <Path Stroke="{DynamicResource Color.Success}" StrokeThickness="18" Fill="Transparent"
                                          Data="M 118,95 A 61,61 0 0 1 65,126"/>
                                    <!-- PC — 20% (72°) orange -->
                                    <Path Stroke="{DynamicResource Color.Warning}" StrokeThickness="18" Fill="Transparent"
                                          Data="M 65,126 A 61,61 0 0 1 13,82"/>
                                    <!-- IoT — 10% (36°) pink -->
                                    <Path Stroke="{DynamicResource Color.Pink}" StrokeThickness="18" Fill="Transparent"
                                          Data="M 13,82 A 61,61 0 0 1 34,19"/>
                                    <!-- Inner fill -->
                                    <Ellipse Width="90" Height="90" Canvas.Left="20" Canvas.Top="20"
                                             Fill="{DynamicResource Bg.Card}"/>
                                    <TextBlock Canvas.Left="42" Canvas.Top="50"
                                               Text="{Binding Devices.Count}" Foreground="{DynamicResource Color.Accent}"
                                               FontFamily="Consolas" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Canvas.Left="46" Canvas.Top="72"
                                               Text="total" Foreground="{DynamicResource Text.Muted}"
                                               FontFamily="Consolas" FontSize="9"/>
                                </Canvas>
                                <!-- Legend -->
                                <StackPanel Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Color.Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Mobile  45%" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Color.Success}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Router  25%" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Color.Warning}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="PC      20%" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Color.Pink}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="IoT     10%" Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Network health meters -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Background="{DynamicResource Border.Card}" Width="1"/>
                            <Border Grid.Column="3" Background="{DynamicResource Border.Card}" Width="1"/>
                            <Border Grid.Column="5" Background="{DynamicResource Border.Card}" Width="1"/>

                            <!-- Signal strength meter -->
                            <StackPanel Grid.Column="0" Margin="16,4">
                                <TextBlock Text="SIGNAL" Style="{StaticResource SectionLbl}" Margin="0,0,0,8"/>
                                <Canvas Width="80" Height="50" HorizontalAlignment="Left">
                                    <!-- Gauge arc background -->
                                    <Path Stroke="{DynamicResource Border.Card}" StrokeThickness="6" Fill="Transparent"
                                          Data="M 5,45 A 40,40 0 0 1 75,45" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <!-- Gauge fill (75%) -->
                                    <Path Stroke="{DynamicResource Color.Success}" StrokeThickness="6" Fill="Transparent"
                                          Data="M 5,45 A 40,40 0 0 1 62,15" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Effect>
                                            <DropShadowEffect Color="#00D68F" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                        </Path.Effect>
                                    </Path>
                                    <TextBlock Canvas.Left="22" Canvas.Top="24" Text="75%" Foreground="{DynamicResource Color.Success}"
                                               FontFamily="Consolas" FontSize="13" FontWeight="Bold"/>
                                </Canvas>
                                <TextBlock Text="Excellent" Foreground="{DynamicResource Color.Success}"
                                           FontFamily="Consolas" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Latency meter -->
                            <StackPanel Grid.Column="2" Margin="16,4">
                                <TextBlock Text="AVG LATENCY" Style="{StaticResource SectionLbl}" Margin="0,0,0,8"/>
                                <Canvas Width="80" Height="50" HorizontalAlignment="Left">
                                    <Path Stroke="{DynamicResource Border.Card}" StrokeThickness="6" Fill="Transparent"
                                          Data="M 5,45 A 40,40 0 0 1 75,45" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Stroke="{DynamicResource Color.Accent}" StrokeThickness="6" Fill="Transparent"
                                          Data="M 5,45 A 40,40 0 0 1 50,8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Effect>
                                            <DropShadowEffect Color="#00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                        </Path.Effect>
                                    </Path>
                                    <TextBlock Canvas.Left="18" Canvas.Top="24" Text="12ms" Foreground="{DynamicResource Color.Accent}"
                                               FontFamily="Consolas" FontSize="13" FontWeight="Bold"/>
                                </Canvas>
                                <TextBlock Text="Very fast" Foreground="{DynamicResource Color.Accent}"
                                           FontFamily="Consolas" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Open ports meter -->
                            <StackPanel Grid.Column="4" Margin="16,4">
                                <TextBlock Text="OPEN PORTS" Style="{StaticResource SectionLbl}" Margin="0,0,0,8"/>
                                <Canvas Width="80" Height="50" HorizontalAlignment="Left">
                                    <Path Stroke="{DynamicResource Border.Card}" StrokeThickness="6" Fill="Transparent"
                                          Data="M 5,45 A 40,40 0 0 1 75,45" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Stroke="{DynamicResource Color.Warning}" StrokeThickness="6" Fill="Transparent"
                                          Data="M 5,45 A 40,40 0 0 1 38,6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Effect>
                                            <DropShadowEffect Color="#F59E0B" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                        </Path.Effect>
                                    </Path>
                                    <TextBlock Canvas.Left="24" Canvas.Top="24" Text="34" Foreground="{DynamicResource Color.Warning}"
                                               FontFamily="Consolas" FontSize="13" FontWeight="Bold"/>
                                </Canvas>
                                <TextBlock Text="Moderate" Foreground="{DynamicResource Color.Warning}"
                                           FontFamily="Consolas" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Security score meter -->
                            <StackPanel Grid.Column="6" Margin="16,4">
                                <TextBlock Text="SECURITY" Style="{StaticResource SectionLbl}" Margin="0,0,0,8"/>
                                <Canvas Width="80" Height="50" HorizontalAlignment="Left">
                                    <Path Stroke="{DynamicResource Border.Card}" StrokeThickness="6" Fill="Transparent"
                                          Data="M 5,45 A 40,40 0 0 1 75,45" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Stroke="{DynamicResource Color.Danger}" StrokeThickness="6" Fill="Transparent"
                                          Data="M 5,45 A 40,40 0 0 1 27,12" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Path.Effect>
                                            <DropShadowEffect Color="#FF4C6A" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                        </Path.Effect>
                                    </Path>
                                    <TextBlock Canvas.Left="20" Canvas.Top="24" Text="62%" Foreground="{DynamicResource Color.Danger}"
                                               FontFamily="Consolas" FontSize="13" FontWeight="Bold"/>
                                </Canvas>
                                <TextBlock Text="Needs review" Foreground="{DynamicResource Color.Danger}"
                                           FontFamily="Consolas" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Sparkline activity graph -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SCAN HISTORY — DEVICES DETECTED" Style="{StaticResource SectionLbl}"/>
                                <TextBlock Grid.Column="1" Text="LAST 8 SCANS" Foreground="{DynamicResource Text.Dim}"
                                           FontFamily="Consolas" FontSize="9"/>
                            </Grid>
                            <!-- Sparkline graph (WPF Polyline) -->
                            <Canvas Height="80" Background="Transparent">
                                <!-- Grid lines -->
                                <Line X1="0" Y1="0"  X2="800" Y2="0"  Stroke="{DynamicResource Border.Card}" StrokeThickness="0.5" StrokeDashArray="4,4"/>
                                <Line X1="0" Y1="27" X2="800" Y2="27" Stroke="{DynamicResource Border.Card}" StrokeThickness="0.5" StrokeDashArray="4,4"/>
                                <Line X1="0" Y1="54" X2="800" Y2="54" Stroke="{DynamicResource Border.Card}" StrokeThickness="0.5" StrokeDashArray="4,4"/>
                                <Line X1="0" Y1="80" X2="800" Y2="80" Stroke="{DynamicResource Border.Card}" StrokeThickness="0.5" StrokeDashArray="4,4"/>
                                <!-- Area fill -->
                                <Polygon Points="0,80 50,55 120,45 200,60 290,35 380,28 460,42 550,18 630,30 800,80" Fill="{DynamicResource Color.Accent}" Opacity="0.06"/>
                                <!-- Sparkline -->
                                <Polyline Points="0,55 50,55 120,45 200,60 290,35 380,28 460,42 550,18 630,30" Stroke="{DynamicResource Color.Accent}"
                                          StrokeThickness="2" StrokeLineJoin="Round">
                                    <Polyline.Effect>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                                    </Polyline.Effect>
                                </Polyline>
                                <!-- Data point dots -->
                                <Ellipse Canvas.Left="47" Canvas.Top="52" Width="6" Height="6" Fill="{DynamicResource Color.Accent}"/>
                                <Ellipse Canvas.Left="117" Canvas.Top="42" Width="6" Height="6" Fill="{DynamicResource Color.Accent}"/>
                                <Ellipse Canvas.Left="197" Canvas.Top="57" Width="6" Height="6" Fill="{DynamicResource Color.Accent}"/>
                                <Ellipse Canvas.Left="287" Canvas.Top="32" Width="6" Height="6" Fill="{DynamicResource Color.Accent}"/>
                                <Ellipse Canvas.Left="377" Canvas.Top="25" Width="6" Height="6" Fill="{DynamicResource Color.Accent}"/>
                                <Ellipse Canvas.Left="457" Canvas.Top="39" Width="6" Height="6" Fill="{DynamicResource Color.Accent}"/>
                                <Ellipse Canvas.Left="547" Canvas.Top="15" Width="6" Height="6" Fill="{DynamicResource Color.Accent}"/>
                                <Ellipse Canvas.Left="627" Canvas.Top="27" Width="6" Height="6" Fill="{DynamicResource Color.Accent}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="8" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <!-- Y-axis labels -->
                                <TextBlock Canvas.Left="0" Canvas.Top="-4" Text="20" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="8"/>
                                <TextBlock Canvas.Left="0" Canvas.Top="23" Text="15" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="8"/>
                                <TextBlock Canvas.Left="0" Canvas.Top="50" Text="10" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="8"/>
                            </Canvas>
                        </StackPanel>
                    </Border>

                    <!-- Device table -->
                    <Border Background="{DynamicResource Bg.Surface}" CornerRadius="10"
                            BorderBrush="{DynamicResource Border.Primary}" BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="16,12"
                                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DISCOVERED DEVICES" Style="{StaticResource SectionLbl}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Select a device to inspect"
                                               Foreground="{DynamicResource Text.Dim}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <DataGrid Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ItemsSource="{Binding Devices}"
                                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource Color.GridLine}"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      RowHeaderWidth="0"
                                      SelectionMode="Single"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="True"
                                      CanUserReorderColumns="False"
                                      AlternationCount="2"
                                      MaxHeight="320"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="IP ADDRESS" Binding="{Binding Ip}" Width="1.3*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"        Value="{DynamicResource Text.TableIp}"/>
                                                <Setter Property="FontFamily"        Value="Consolas"/>
                                                <Setter Property="FontSize"          Value="12"/>
                                                <Setter Property="FontWeight"        Value="Bold"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin"            Value="12,10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="MAC ADDRESS" Binding="{Binding Mac}" Width="1.5*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"        Value="{DynamicResource Text.TableMac}"/>
                                                <Setter Property="FontFamily"        Value="Consolas"/>
                                                <Setter Property="FontSize"          Value="11"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin"            Value="12,10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="HOSTNAME" Binding="{Binding Hostname}" Width="1.5*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"        Value="{DynamicResource Text.TableHost}"/>
                                                <Setter Property="FontFamily"        Value="Consolas"/>
                                                <Setter Property="FontSize"          Value="12"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin"            Value="12,10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="VENDOR" Binding="{Binding Vendor}" Width="1.4*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"        Value="{DynamicResource Text.TableVendor}"/>
                                                <Setter Property="FontFamily"        Value="Consolas"/>
                                                <Setter Property="FontSize"          Value="11"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin"            Value="12,10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="STATUS" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Margin="12,8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border Background="{DynamicResource Bg.TagNew}" CornerRadius="4"
                                                            Padding="7,3" HorizontalAlignment="Left">
                                                        <TextBlock Text="NEW" Foreground="{DynamicResource Color.Success}"
                                                                   FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="FIRST SEEN" Binding="{Binding FirstSeen}" Width="1.3*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"        Value="{DynamicResource Text.TableTime}"/>
                                                <Setter Property="FontFamily"        Value="Consolas"/>
                                                <Setter Property="FontSize"          Value="10"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin"            Value="12,10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="LAST SEEN" Binding="{Binding LastSeen}" Width="1.3*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"        Value="{DynamicResource Text.TableTime}"/>
                                                <Setter Property="FontFamily"        Value="Consolas"/>
                                                <Setter Property="FontSize"          Value="10"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin"            Value="12,10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ════════════════════════════════════════════════
                 PAGE 2 — DEVICE INVENTORY
                 ════════════════════════════════════════════════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NavInventory}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="24,20,24,24">
                    <!-- Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DEVICE INVENTORY" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Named devices stored from your scans" Style="{StaticResource PageSub}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="ADD DEVICE" Style="{StaticResource PrimaryBtn}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Search + filter bar -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputBox}" Text="" Margin="0,0,12,0">
                                <TextBox.Tag>Search by name, IP or MAC…</TextBox.Tag>
                            </TextBox>
                            <ComboBox Grid.Column="1" Style="{StaticResource ComboStyle}" Margin="0,0,12,0">
                                <ComboBoxItem Content="All Types" IsSelected="True"/>
                                <ComboBoxItem Content="Mobile"/>
                                <ComboBoxItem Content="Computer"/>
                                <ComboBoxItem Content="Router"/>
                                <ComboBoxItem Content="IoT"/>
                            </ComboBox>
                            <ComboBox Grid.Column="2" Style="{StaticResource ComboStyle}">
                                <ComboBoxItem Content="All Status" IsSelected="True"/>
                                <ComboBoxItem Content="Online"/>
                                <ComboBoxItem Content="Offline"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Summary tiles -->
                    <UniformGrid Columns="4" Rows="1" Margin="0,0,0,16">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL NAMED" Style="{StaticResource SectionLbl}"/>
                                <TextBlock Text="0" Foreground="{DynamicResource Color.Accent}"
                                           FontFamily="Consolas" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="ONLINE NOW" Style="{StaticResource SectionLbl}"/>
                                <TextBlock Text="0" Foreground="{DynamicResource Color.Success}"
                                           FontFamily="Consolas" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="OFFLINE" Style="{StaticResource SectionLbl}"/>
                                <TextBlock Text="0" Foreground="{DynamicResource Text.Secondary}"
                                           FontFamily="Consolas" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="UNNAMED" Style="{StaticResource SectionLbl}"/>
                                <TextBlock Text="0" Foreground="{DynamicResource Color.Warning}"
                                           FontFamily="Consolas" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Inventory card grid -->
                    <TextBlock Text="YOUR DEVICES" Style="{StaticResource SectionLbl}" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource Bg.Surface}" CornerRadius="10"
                            BorderBrush="{DynamicResource Border.Primary}" BorderThickness="1" Padding="16">
                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                            <TextBlock Text="▤" Foreground="{DynamicResource Text.Muted}" FontSize="40"
                                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="NO DEVICES IN INVENTORY"
                                       Foreground="{DynamicResource Text.EmptyState}"
                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Run a scan then name your devices to build your inventory"
                                       Foreground="{DynamicResource Text.EmptySub}"
                                       FontFamily="Consolas" FontSize="10"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            <Button Content="RUN SCAN NOW" Style="{StaticResource PrimaryBtn}"
                                    HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ════════════════════════════════════════════════
                 PAGE 3 — DEVICE DETAILS
                 ════════════════════════════════════════════════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NavDetails}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="24,20,24,24">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DEVICE DETAILS" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Select a device from Network Scan to inspect" Style="{StaticResource PageSub}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="REFRESH" Style="{StaticResource GhostBtn}"/>
                    </Grid>

                    <!-- Selected device header card -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Device icon -->
                            <Border Width="60" Height="60" CornerRadius="30"
                                    Background="{DynamicResource Bg.Input}"
                                    BorderBrush="{DynamicResource Color.Accent}" BorderThickness="1.5"
                                    Margin="0,0,16,0">
                                <TextBlock Text="◧" Foreground="{DynamicResource Color.Accent}"
                                           FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDevice.Hostname, FallbackValue='No device selected'}"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontFamily="Consolas" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedDevice.Ip, FallbackValue='—'}"
                                           Foreground="{DynamicResource Color.Accent}"
                                           FontFamily="Consolas" FontSize="13" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding SelectedDevice.Vendor, FallbackValue='Unknown vendor'}"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           FontFamily="Consolas" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Border Background="{DynamicResource Bg.TagNew}" CornerRadius="20"
                                        Padding="12,5" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Color.Success}"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ONLINE" Foreground="{DynamicResource Color.Success}"
                                                   FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Properties grid -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Left column -->
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="NETWORK PROPERTIES" Style="{StaticResource SectionLbl}" Margin="0,0,0,14"/>
                                <!-- Property rows -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="IP Address" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.Ip, FallbackValue='—'}"
                                               Foreground="{DynamicResource Text.TableIp}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="MAC Address" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.Mac, FallbackValue='—'}"
                                               Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hostname" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.Hostname, FallbackValue='—'}"
                                               Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Vendor" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.Vendor, FallbackValue='—'}"
                                               Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="First Seen" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.FirstSeen, FallbackValue='—'}"
                                               Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- Right column -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="ACTIVITY METRICS" Style="{StaticResource SectionLbl}" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Last Seen" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.LastSeen, FallbackValue='—'}"
                                               Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Status" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="Online" Foreground="{DynamicResource Color.Success}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Avg Latency" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="12 ms" Foreground="{DynamicResource Color.Accent}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Open Ports" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="—" Foreground="{DynamicResource Color.Warning}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                </Grid>
                                <TextBlock Text="CONNECTION QUALITY" Style="{StaticResource SectionLbl}" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="35"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Signal" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10"/>
                                        <ProgressBar Grid.Column="1" Value="85" Maximum="100" Style="{StaticResource MeterBarGreen}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="85%" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="35"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Uptime" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10"/>
                                        <ProgressBar Grid.Column="1" Value="99" Maximum="100" Style="{StaticResource MeterBar}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="99%" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Quick actions for selected device -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="QUICK ACTIONS" Style="{StaticResource SectionLbl}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="PING DEVICE"    Style="{StaticResource GhostBtn}" Margin="0,0,8,0"/>
                                <Button Content="SCAN PORTS"     Style="{StaticResource GhostBtn}" Margin="0,0,8,0"/>
                                <Button Content="TRACEROUTE"     Style="{StaticResource GhostBtn}" Margin="0,0,8,0"/>
                                <Button Content="WAKE-ON-LAN"    Style="{StaticResource GhostBtn}" Margin="0,0,8,0"/>
                                <Button Content="COPY IP"        Style="{StaticResource GhostBtn}" Command="{Binding CopyIpCommand}" Margin="0,0,8,0"/>
                                <Button Content="COPY MAC"       Style="{StaticResource GhostBtn}" Command="{Binding CopyMacCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ════════════════════════════════════════════════
                 PAGE 4 — ALERTS
                 ════════════════════════════════════════════════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NavAlerts}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="24,20,24,24">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ALERTS" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="New device detections and network events" Style="{StaticResource PageSub}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="CLEAR ALL" Style="{StaticResource DangerBtn}" Margin="0,0,8,0"/>
                            <Button Content="SETTINGS"  Style="{StaticResource GhostBtn}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Alert summary -->
                    <UniformGrid Columns="4" Rows="1" Margin="0,0,0,16">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL ALERTS" Style="{StaticResource SectionLbl}"/>
                                <TextBlock Text="0" Foreground="{DynamicResource Text.Primary}" FontFamily="Consolas" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="NEW DEVICES" Style="{StaticResource SectionLbl}"/>
                                <TextBlock Text="0" Foreground="{DynamicResource Color.Warning}" FontFamily="Consolas" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="SECURITY" Style="{StaticResource SectionLbl}"/>
                                <TextBlock Text="0" Foreground="{DynamicResource Color.Danger}" FontFamily="Consolas" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="INFO" Style="{StaticResource SectionLbl}"/>
                                <TextBlock Text="0" Foreground="{DynamicResource Color.Accent}" FontFamily="Consolas" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Alert feed -->
                    <TextBlock Text="RECENT ALERTS" Style="{StaticResource SectionLbl}" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource Bg.Surface}" CornerRadius="10"
                            BorderBrush="{DynamicResource Border.Primary}" BorderThickness="1">

                        <!-- Sample alert items (these would be data-bound in real implementation) -->
                        <!-- Alert row: NEW DEVICE -->
                        <StackPanel>
                            <Border Padding="16,14" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Bg.TagError}" VerticalAlignment="Center">
                                        <TextBlock Text="◈" Foreground="{DynamicResource Color.Warning}" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock Text="NEW DEVICE DETECTED" Foreground="{DynamicResource Text.Primary}"
                                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="Unknown device connected: MAC AA:BB:CC:DD:EE:FF  · 192.168.1.45"
                                                   Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="2 min ago" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right"/>
                                        <Border Background="{DynamicResource Bg.TagError}" CornerRadius="4" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="WARNING" Foreground="{DynamicResource Color.Warning}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Alert row: SECURITY -->
                            <Border Padding="16,14" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Bg.TagError}" VerticalAlignment="Center">
                                        <TextBlock Text="◉" Foreground="{DynamicResource Color.Danger}" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock Text="OPEN PORT DETECTED" Foreground="{DynamicResource Text.Primary}"
                                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="Port 22 (SSH) open on 192.168.1.1 — verify this is expected"
                                                   Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="1 hr ago" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right"/>
                                        <Border Background="{DynamicResource Bg.TagError}" CornerRadius="4" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="SECURITY" Foreground="{DynamicResource Color.Danger}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Alert row: INFO -->
                            <Border Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Bg.Input}" VerticalAlignment="Center">
                                        <TextBlock Text="⬡" Foreground="{DynamicResource Color.Accent}" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock Text="SCAN COMPLETED" Foreground="{DynamicResource Text.Primary}"
                                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="Network scan finished — 12 devices found, 1 new"
                                                   Foreground="{DynamicResource Text.Secondary}" FontFamily="Consolas" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="3 hr ago" Foreground="{DynamicResource Text.Muted}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right"/>
                                        <Border Background="{DynamicResource Bg.Input}" CornerRadius="4" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="INFO" Foreground="{DynamicResource Color.Accent}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
